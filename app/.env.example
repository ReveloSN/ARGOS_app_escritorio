# Solo para desarrollar la interfaz en el navegador, sin Tauri.
# 1. Arranque el motor con un token y un puerto fijos:
#      cd engine && ARGUS_ENGINE_TOKEN=dev-token uv run python -m argus --port 8765
# 2. Copie este archivo como app/.env.local y ejecute npm run dev.
# Dentro de Tauri estas variables se ignoran: la app lanza el motor con puerto y token propios.
VITE_ENGINE_URL=http://127.0.0.1:8765
VITE_ENGINE_TOKEN=dev-token
